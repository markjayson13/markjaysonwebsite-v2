---
import BaseLayout from "../layouts/BaseLayout.astro";

const lastUpdated = "November 5, 2026";

const sections = [
  {
    title: "Information We Collect",
    body:
      "This site collects only the information you choose to send through the contact form: your name, email address, subject, and message. Cloudflare, which hosts the site, may log technical details such as IP address, browser type, and pages requested for security and performance.",
  },
  {
    title: "How the Contact Form Works",
    body:
      "Messages sent through the contact form are delivered by FormSubmit (formsubmit.co), which passes the form contents to my email inbox. FormSubmit handles that data under its own privacy policy.",
  },
  {
    title: "How Information Is Used",
    body:
      "Anything you send is used only to read and reply to your message about research, collaboration, creative work, speaking, or professional opportunities. It is not sold and is not added to marketing lists.",
  },
  {
    title: "Third-Party Links",
    body:
      "This site links to other platforms, including LinkedIn, GitHub, Google Scholar, ORCID, ResearchGate, Macro by Mark, and my creative site. Those sites have their own privacy practices.",
  },
  {
    title: "Contact",
    body:
      "Questions about privacy or data handling can be sent through the homepage contact form or by email at markjayson@markjayson.com.",
  },
];
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy Policy for markjayson.com."
  page="privacy"
  accent="#050505"
  replicaMotion={true}
>
  <article class="replica-page legal-page">
    <div class="replica-canvas legal-page__canvas">
      <header class="legal-page__header">
        <p class="legal-page__eyebrow">Legal</p>
        <h1 class="legal-page__title" data-lift>Privacy Policy</h1>
        <p class="legal-page__lead" data-lift>
          What information markjayson.com collects and how it is handled. Last updated {lastUpdated}.
        </p>
      </header>

      <div class="legal-page__sections">
        {
          sections.map((section) => (
            <section class="legal-page__section" data-lift>
              <h2>{section.title}</h2>
              <p>{section.body}</p>
            </section>
          ))
        }
      </div>
    </div>
  </article>
</BaseLayout>
