---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { profilesPage } from "../data/editorial";
import { buildPrimaryImageStructuredData, buildProfilePageStructuredData } from "../data/site";

const pageTitle = "Profiles & Links";
const pageDescription =
  "Find Mark Jayson Farol on LinkedIn, GitHub, Google Scholar, ORCID, ResearchGate, Instagram, Backstage, and his creative portfolio.";
const siteOrigin = Astro.site ?? new URL("https://markjayson.com");
const pageUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const profilesHeadshot = profilesPage.headshot;
const structuredData = [
  ...buildProfilePageStructuredData(pageUrl, pageTitle, pageDescription),
  ...buildPrimaryImageStructuredData(pageUrl, {
    src: profilesHeadshot.src,
    alt: profilesHeadshot.alt,
    caption: "Primary headshot of Mark Jayson Farol",
  }),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  page="profiles"
  accent="#efefea"
  replicaMotion={true}
  structuredData={structuredData}
>
  <article class="replica-page profiles-page profiles-page--canva">
    <video
      class="profiles-page__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src={profilesPage.videoSrc} type="video/mp4" />
    </video>
    <div class="profiles-page__shade" aria-hidden="true"></div>

    <div class="replica-canvas profiles-page__canvas">
      <header class="profiles-page__header">
        <img
          class="profiles-page__headshot"
          src={profilesPage.headshot.src}
          alt={profilesPage.headshot.alt}
          width={profilesPage.headshot.width}
          height={profilesPage.headshot.height}
          loading="eager"
          data-lift
        />
        <h1 class="profiles-page__title" data-lift>{profilesPage.title}</h1>
        <p class="profiles-page__lead" data-lift>{profilesPage.lead}</p>
      </header>

      {
        profilesPage.groups.map((group) => (
          <section class="profiles-page__group" aria-label={group.title}>
            <h2 class="profiles-page__group-title">{group.title}</h2>
            <div class="profiles-page__grid" role="list">
              {group.buttons.map((button) => (
                <a class="profiles-page__button" href={button.href} target="_blank" rel="me noreferrer" data-lift role="listitem">
                  <span class="profiles-page__symbol" aria-hidden="true"><SocialIcon icon={button.icon} /></span>
                  <span>{button.label}</span>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>
